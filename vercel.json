{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mocwo.onrender.com/api/:path*"
    },
    {
      "source": "/_/backend(/.*)?",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js",
      "rewrites": [
        {
          "source": "/_/backend/:path(.*)?",
          "destination": "/:path"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "frontend",
          "format": "url",
          "env": "FRONTEND_URL"
        }
      ]
    }
  },
  "build": {
    "env": {
      "VITE_FRONTEND_URL": "/",
      "VITE_BACKEND_URL": "/_/backend"
    }
  }
}
